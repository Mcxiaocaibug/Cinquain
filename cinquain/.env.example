# Generated values are written by install.sh or the web panel. Do not commit .env.
CINQUAIN_VERSION=0.0.1
CINQUAIN_STACK_NAME=cinquain
CINQUAIN_SERVER_NAME=matrix.example.com
CINQUAIN_OPERATOR_EMAIL=admin@example.com
CINQUAIN_HOMESERVER_IMAGE=ghcr.io/mcxiaocaibug/cinquain:0.0.1
CINQUAIN_CADDY_IMAGE=docker.io/caddy:2.11.4-alpine
CINQUAIN_HTTP_PORT=80
CINQUAIN_HTTPS_PORT=443
CINQUAIN_BACKUP_RETENTION=7
CINQUAIN_LOG_LEVEL=info
CINQUAIN_TIMEZONE=UTC
